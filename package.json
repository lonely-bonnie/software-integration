{
  "name": "astradesk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "author": "lonely-bonnie",
  "license": "UNLICENSED",
  "description": "AstraDesk — a modular desktop workspace for service links and read-only monitoring.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "node scripts/dev-desktop.cjs",
    "format": "prettier --write src electron scripts tests docs *.json *.html *.ts",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "icons": "node scripts/create-icon.cjs",
    "package:win": "npm run build && electron-builder --win dir",
    "portable:win": "npm run build && electron-builder --win portable",
    "installer:win": "npm run build && electron-builder --win nsis --x64",
    "release:win": "node scripts/release.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "dev.riderconsole.workbench",
    "productName": "AstraDesk",
    "directories": {
      "output": "../RiderConsole/releases/${version}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "dir",
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "AstraDesk-${version}-windows-x64-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "AstraDesk",
      "uninstallDisplayName": "AstraDesk",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "artifactName": "AstraDesk-${version}-windows-x64-setup.exe",
      "include": "build/installer.nsh"
    }
  },
  "homepage": "https://github.com/lonely-bonnie/software-integration",
  "repository": {
    "type": "git",
    "url": "https://github.com/lonely-bonnie/software-integration.git"
  }
}
